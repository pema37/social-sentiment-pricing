# =============================================================
# ActualPrice / Social Sentiment Pricing - Environment Variables
# =============================================================
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# NEVER commit .env to git. NEVER use production credentials locally.
# See DEVELOPER_SETUP.md for detailed instructions on getting each key.
# =============================================================

# --- Database (REQUIRED) ---
# Use your LOCAL database, not production.
# Local PostgreSQL:
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/ssp_dev
# Docker alternative:
# DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/ssp_dev

# --- Authentication (REQUIRED) ---
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-your-own-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Google Gemini AI (needed for AI features) ---
# Get free key: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# --- Shopify (only if assigned Shopify tasks) ---
# Create dev store: https://partners.shopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000

# --- Social APIs (only if assigned sentiment tasks) ---
# Twitter: https://developer.twitter.com
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# Reddit: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# NewsAPI: https://newsapi.org (free: 100 req/day)
NEWS_API_KEY=

# --- Redis (only if working on background jobs) ---
# Docker: docker run -p 6379:6379 -d redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# --- App Settings ---
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

