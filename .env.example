# =============================================================
# ActualPrice / Social Sentiment Pricing - Environment Variables
# =============================================================
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# NEVER commit .env to git. NEVER use production credentials locally.
# See DEVELOPER_SETUP.md for detailed instructions.
#
# This file matches backend/core/config.py exactly.
# =============================================================


# --- Application ---
APP_NAME=Social Sentiment Pricing API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true


# --- Database (REQUIRED) ---
# Use your LOCAL database, not production.
# Local PostgreSQL:
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/ssp_dev
# Docker alternative:
# DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/ssp_dev


# --- URLs ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000


# --- Security / JWT (REQUIRED) ---
# Generate each: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-your-own-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY=generate-your-own-encryption-key-here


# --- CORS ---
CORS_ORIGINS=http://localhost:3000


# --- Redis / Celery (only if working on background jobs) ---
# Install Redis locally or use Docker: docker run -p 6379:6379 -d redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1


# --- Monitoring (optional for local dev) ---
# Sentry: https://sentry.io (free tier available)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
LOG_FORMAT=console


# --- Google Gemini AI (needed for AI features) ---
# Get free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- OpenAI (needed for certain sentiment features) ---
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- You.com Search API (needed for competitor matching) ---
# Get key: https://api.you.com
YOUCOM_API_KEY=


# --- Reddit (only if assigned sentiment tasks) ---
# Create app: https://www.reddit.com/prefs/apps (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SocialSentimentPricing/1.0

# --- Twitter/X (future) ---
# https://developer.twitter.com
TWITTER_BEARER_TOKEN=


# --- Shopify (only if assigned Shopify tasks) ---
# Create a dev store: https://partners.shopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- WooCommerce (only if assigned WooCommerce tasks) ---
# Generate keys in WooCommerce Settings REST API
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=


# --- Notifications (optional) ---
# SendGrid: https://sendgrid.com (free tier: 100 emails/day)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Slack: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=


# --- Alerting (optional) ---
ALERT_EMAIL=
PAGERDUTY_KEY=


# --- MNEE Payments (only if assigned payment tasks) ---
MNEE_API_KEY=
MNEE_ENVIRONMENT=sandbox
MNEE_WEBHOOK_SECRET=
SSP_MNEE_WALLET_ADDRESS=


# =============================================================
# MINIMUM TO GET STARTED (just these 3):
# =============================================================
# 1. DATABASE_URL    → Set up local PostgreSQL (see DEVELOPER_SETUP.md)
# 2. JWT_SECRET_KEY  → python3 -c "import secrets; print(secrets.token_hex(32))"
# 3. ENCRYPTION_KEY  → python3 -c "import secrets; print(secrets.token_hex(32))"
#
# For AI features, also add:
# 4. GEMINI_API_KEY  → https://aistudio.google.com/apikey (free)
#
# Everything else can stay blank until you need it.
# =============================================================

