# API Configuration
NEXT_PUBLIC_API_URL=https://social-sentiment-pricing-production.up.railway.app
NEXT_PUBLIC_WS_URL=wss://social-sentiment-pricing-production.up.railway.app/ws

# Application
NEXT_PUBLIC_APP_NAME=Social Sentiment Pricing
