NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Auth
NEXT_PUBLIC_TOKEN_KEY=ssp_access_token

# Pagination
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20

# Sentry
NEXT_PUBLIC_SENTRY_DSN=


