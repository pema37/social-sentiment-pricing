# API Configuration - Set via Vercel Environment Variables
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Application
NEXT_PUBLIC_APP_NAME=Social Sentiment Pricing
NEXT_PUBLIC_APP_URL=

# Feature Flags
NEXT_PUBLIC_ENABLE_WEBSOCKETS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Auth
NEXT_PUBLIC_TOKEN_KEY=ssp_access_token

# Pagination
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20

# Sentry - Set via Vercel Environment Variables
NEXT_PUBLIC_SENTRY_DSN=
