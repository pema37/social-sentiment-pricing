# ===================
# API Configuration
# ===================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ===================
# Application
# ===================
NEXT_PUBLIC_APP_NAME=Social Sentiment Pricing
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================
# Feature Flags
# ===================
NEXT_PUBLIC_ENABLE_WEBSOCKETS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ===================
# Auth
# ===================
NEXT_PUBLIC_TOKEN_KEY=ssp_access_token

# ===================
# Pagination
# ===================
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20

# ===================
# Sentry (Error Tracking)
# ===================
NEXT_PUBLIC_SENTRY_DSN=

# ===================
# Production Example
# ===================
# NEXT_PUBLIC_API_URL=https://api.ourdomain.com/api/v1
# NEXT_PUBLIC_WS_URL=wss://api.ourdomain.com/ws
# NEXT_PUBLIC_APP_URL=https://ourdomain.com
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
