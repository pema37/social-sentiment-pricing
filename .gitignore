##############################################
# Node / Next.js
##############################################

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov
.nyc_output/

# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Next.js build output
.next/
out/

# Parcel / Vite / Other caches
.cache/
.parcel-cache/
**/.vitepress/cache/
**/.vitepress/dist/

# TypeScript cache
*.tsbuildinfo

# Optional caches
.npm/
.eslintcache/
.stylelintcache/

# Output of 'npm pack'
*.tgz

# Yarn
.yarn/*
.pnp.*

# dotenv environment files
.env
.env.*
!.env.example

##############################################
# Python / FastAPI
##############################################

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# Build artifacts
build/
dist/
*.egg-info/

##############################################
# OS / Editor files
##############################################

.DS_Store
Thumbs.db
.vscode/
.idea/

dummy.db
