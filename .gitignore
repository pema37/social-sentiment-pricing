##############################################
# Node / Next.js
##############################################

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports
report.*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov
.nyc_output/

# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Next.js build output
.next/
out/

# Parcel / Vite / Other caches
.cache/
.parcel-cache/
**/.vitepress/cache/
**/.vitepress/dist/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Optional caches
.npm/
.eslintcache/
.stylelintcache/

# Output of 'npm pack'
*.tgz

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# Vercel
.vercel

# Build
/build

##############################################
# Python / FastAPI
##############################################

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# Build artifacts
build/
dist/
*.egg-info/

##############################################
# Database files
##############################################

*.db
*.sqlite
*.sqlite3

##############################################
# Environment files
##############################################

# Ignore all env files
.env
.env.*
backend/.env
backend/.env.*
frontend/.env.local
frontend/.env.*

# Keep examples
!.env.example
!backend/.env.example
!frontend/.env.example

##############################################
# OS / Editor files
##############################################

.DS_Store
Thumbs.db
.vscode/
.idea/
*.pem
.claude/
